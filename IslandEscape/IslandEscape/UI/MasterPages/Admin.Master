<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="IslandEscape.UI.MasterPages.Admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin - Island Escape Adventures</title>
    <link href="~/Assets/CSS/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Assets/CSS/google-fonts.css" rel="stylesheet" />
    <link href="~/Assets/CSS/Admin.css" rel="stylesheet" />
    <link href="~/Assets/CSS/Site.css" rel="stylesheet" />
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="admin-wrapper">
            <div class="admin-sidebar">
                <div class="sidebar-brand">
                    <h3>Island Escape <small>Admin Panel</small></h3>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="~/UI/Admin/Dashboard.aspx" runat="server">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/UI/Admin/ManagePackages.aspx" runat="server">
                            <i class="bi bi-box"></i> Packages
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/UI/Admin/ManageUsers.aspx" runat="server">
                            <i class="bi bi-people"></i> Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/UI/Admin/ManageBookings.aspx" runat="server">
                            <i class="bi bi-calendar-check"></i> Bookings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/UI/Admin/ManageQueries.aspx" runat="server">
                            <i class="bi bi-envelope"></i> Queries
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/UI/Public/Default.aspx" runat="server">
                            <i class="bi bi-box-arrow-right"></i> View Site
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/UI/Admin/Reports.aspx" runat="server">
                            <i class="bi bi-bar-chart"></i> <span>Reports</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/UI/Public/Logout.aspx" runat="server">
                            <i class="bi bi-power"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
            
            <div class="admin-main">
                <div class="admin-topbar">
                    <h4><asp:ContentPlaceHolder ID="PageTitle" runat="server">Dashboard</asp:ContentPlaceHolder></h4>
                    <div class="user-info">
                        <span>Welcome, Admin</span>
                        <div class="avatar">A</div>
                    </div>
                </div>
                
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
        
        <script src="~/Assets/JS/jquery-3.7.1.min.js"></script>
        <script src="~/Assets/JS/bootstrap.bundle.min.js"></script>
        <script src="~/Assets/JS/Admin.js"></script>
        <script src="~/Assets/JS/Site.js"></script>
        
        <asp:ContentPlaceHolder ID="ScriptContent" runat="server">
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>